# Copie este arquivo para .env (na mesma pasta) e preencha com os seus valores.
# O .env NUNCA vai para o Git; este .env.example vai, porque não tem segredo.
#
# Salve em UTF-8 SEM BOM: com BOM, a primeira variável é ignorada sem erro.
# A URL não pode terminar com "/".
# Sem TURSO_URL e TURSO_TOKEN, a API usa o arquivo local tarefas.db.

TURSO_URL=libsql://seu-banco.turso.io
TURSO_TOKEN=seu-token-aqui

# Opcional: chave que assina os tokens JWT. Em produção, defina sempre.
# JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
