{
  "name": "dsw-gerenciador-tarefas",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "tsc",
    "build:web": "pnpm --dir ../../app-react/web build",
    "dev:web": "pnpm --dir ../../app-react/web dev",
    "dev:all": "concurrently -n api,web -c blue,green \"pnpm dev\" \"pnpm dev:web\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
